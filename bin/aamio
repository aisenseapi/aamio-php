#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * aamio on the command line, from PHP. The same commands as aamio-python's
 * CLI, over the same home directory layout.
 *
 *   aamio [--home DIR] [--host URL] [--tags a,b] [--no-archive] <command> ...
 *
 *   init | whoami | partner add NAME KEY | partner list | partner remove NAME
 *   lookup [NAME ...] [--wait N] | send TO TEXT [--data JSON] | read [--wait N]
 *   receipt [--channel LABEL] [--anchor] | channel open LABEL [--ttl N] [--allow a,b]
 *   archive [status|keep|off|days:N|prune] [--max-mb M] [--all] | doctor
 *   channel list | channel close LABEL | board post KIND TITLE TEXT [--tags a,b] [--ttl N] [--lang L] [--deadline ISO] [--scope NAME]
 *   board find [--kind K] [--tags a,b] [--lang L] [--after N] [--wait N] [--min-work-bits N] [--scope NAME]
 *   board tags | board answer POST TEXT [--scope NAME] | board replies [--post ID] [--wait N] | board withdraw POST
 *   (board replies filters. read shows everything on the inbox, opened bodies and the ones that would not open)
 *   board channel KEY [--ttl N] [--reply-to W] [--note TEXT]
 *   scope new NAME | scope add NAME (--key KEY | --address ADDRESS) | scope list | scope key NAME
 *   scope share NAME PARTNER --access read|write | scope remove NAME
 *   (a key given to scope add stays in the shell history, so scope share from runtime to runtime is better)
 *   outbox pending | outbox retry [--id ID] | outbox forget ID | serve
 */

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php', __DIR__ . '/../tests/bootstrap.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

use Aamio\Compat;
use Aamio\GateStop;
use Aamio\Http;
use Aamio\McpServer;
use Aamio\Runtime;
use Aamio\SendFailed;
use Aamio\Storage;

function out(mixed $value): void
{
    fwrite(STDOUT, json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
}

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, $message . "\n");
    exit($code);
}

/** Splits argv into positionals and --options; an option followed by a value takes it, a bare flag is true. */
function parse(array $argv, array $flags = []): array
{
    $positional = [];
    $options = [];
    for ($i = 0; $i < count($argv); $i++) {
        $arg = $argv[$i];
        if (str_starts_with($arg, '--')) {
            $name = substr($arg, 2);
            if (str_contains($name, '=')) {
                [$name, $value] = explode('=', $name, 2);
                $options[$name] = $value;
            } elseif (in_array($name, $flags, true) || !isset($argv[$i + 1]) || str_starts_with($argv[$i + 1], '--')) {
                $options[$name] = true;
            } else {
                $options[$name] = $argv[++$i];
            }
        } else {
            $positional[] = $arg;
        }
    }

    return [$positional, $options];
}

function csv(?string $text): ?array
{
    if ($text === null || $text === '') {
        return null;
    }

    return array_values(array_filter(array_map('trim', explode(',', $text)), static fn (string $t): bool => $t !== ''));
}

[$args, $opts] = parse(array_slice($argv, 1), ['no-archive', 'anchor']);
$command = $args[0] ?? null;
if ($command === null || in_array($command, ['help', '-h'], true)) {
    fail(trim(preg_replace('/^ \* ?/m', '', (string) preg_replace('!^.*?/\*\*(.*?)\*/.*$!s', '$1', (string) file_get_contents(__FILE__)))), 0);
}

try {
    // --tags on `board post` is the tags of that post, and on `board find` a
    // filter. Every --tags used to become this runtime's own: whoami showed the
    // last post's tags, and presence published them as where this key can be
    // reached. --no-archive is one command; the folder's own choice is the
    // default and lives in config.json.
    $runtimeTags = $command === 'board' ? null : csv($opts['tags'] ?? null);
    $runtime = new Runtime($opts['home'] ?? null, $opts['host'] ?? null, $runtimeTags, isset($opts['no-archive']) ? false : null, static fn (string $line) => fwrite(STDERR, $line . "\n"));
} catch (\Throwable $error) {
    fail($error->getMessage());
}
// The lock goes with the process however it ends. fail() exits, and an exit
// inside try never reaches finally, so a command that failed on its arguments
// used to leave the home locked.
register_shutdown_function([$runtime, 'close']);

try {
    switch ($command) {
        case 'init':
            if (isset($opts['archive'])) {
                $runtime->setArchive(Storage::parsePolicy((string) $opts['archive'], isset($opts['max-mb']) ? (float) $opts['max-mb'] : null));
            }
            $runtime->ensureInbox();
            $runtime->saveState();
            // Said once, where a person sets the runtime up: the service
            // forgets, and this folder does not unless it is told to.
            out($runtime->whoami() + ['local_storage' => Storage::status($runtime->home, $runtime->archivePolicy) + ['home' => $runtime->home, 'who_can_read' => Storage::check($runtime->home)]]);
            break;
        case 'archive':
            $policy = (string) ($args[1] ?? 'status');
            if ($policy === 'prune') {
                $gone = Storage::prune($runtime->home, $runtime->archivePolicy, null, isset($opts['all']));
                out(Storage::status($runtime->home, $runtime->archivePolicy) + ['removed' => $gone['removed']]);
            } elseif ($policy === 'status') {
                out(Storage::status($runtime->home, $runtime->archivePolicy));
            } else {
                $runtime->setArchive(Storage::parsePolicy($policy, isset($opts['max-mb']) ? (float) $opts['max-mb'] : null));
                out(Storage::status($runtime->home, $runtime->archivePolicy));
            }
            break;
        case 'doctor':
            // One answer to three questions: does this client fit the service,
            // who can read the home, what is kept. Nothing here is a guess
            // reported as a finding: what could not be checked says so.
            $health = $runtime->client->health();
            $service = ['host' => $runtime->host, 'reachable' => $health['status'] === 200];
            if ($health['status'] === 200 && is_array($health['body'])) {
                $service['version'] = $health['body']['version'] ?? null;
                $service['revision'] = $health['body']['revision'] ?? null;
            } else {
                $service['problem'] = 'no answer from /health (' . $health['status'] . '), so nothing below about the service was checked';
            }
            $descriptor = $runtime->client->descriptor();
            $fits = Compat::check($descriptor['status'] === 200 && is_array($descriptor['body']) ? $descriptor['body'] : null);
            if ($descriptor['status'] !== 200) {
                $fits['verdict'] = 'unknown';
                $fits['why'] = 'the descriptor could not be read (' . $descriptor['status'] . '), so compatibility was not checked';
            }
            out([
                'client' => ['name' => 'aamio-php', 'version' => Http::VERSION, 'protocol' => Compat::PROTOCOL],
                'service' => $service,
                'compatibility' => $fits,
                'storage' => Storage::check($runtime->home),
                'archive' => Storage::status($runtime->home, $runtime->archivePolicy),
                'outbox_pending' => count($runtime->outboxPending()),
            ]);
            break;
        case 'whoami':
            out($runtime->whoami());
            break;
        case 'partner':
            $action = $args[1] ?? '';
            if ($action === 'add') {
                $runtime->partnerAdd((string) ($args[2] ?? fail('partner add NAME KEY')), (string) ($args[3] ?? fail('partner add NAME KEY')));
                out($runtime->partnerList());
            } elseif ($action === 'list') {
                out($runtime->partnerList());
            } elseif ($action === 'remove') {
                $runtime->partnerRemove((string) ($args[2] ?? fail('partner remove NAME')));
                out($runtime->partnerList());
            } else {
                fail('partner add|list|remove');
            }
            break;
        case 'lookup':
            out($runtime->lookup(array_slice($args, 1) ?: null, (int) ($opts['wait'] ?? 0)));
            break;
        case 'send':
            $data = isset($opts['data']) ? json_decode((string) $opts['data'], true, 512, JSON_THROW_ON_ERROR) : null;
            out($runtime->send((string) ($args[1] ?? fail('send TO TEXT')), (string) ($args[2] ?? fail('send TO TEXT')), is_array($data) ? $data : null));
            break;
        case 'read':
            // attention carries what the read could not do. Without it an
            // expired thread and a service that did not answer both read as
            // no messages at all.
            $messages = $runtime->read((int) ($opts['wait'] ?? 0));
            out(['messages' => $messages, 'count' => count($messages), 'attention' => $runtime->attentionTaken()]);
            break;
        case 'receipt':
            out($runtime->receipt((string) ($opts['channel'] ?? 'inbox'), isset($opts['anchor'])));
            break;
        case 'channel':
            $action = $args[1] ?? '';
            if ($action === 'open') {
                // A shell eats quotes, so a gate that will not parse is named by the
                // option the person typed, not by a decoder they cannot see.
                $gate = null;

                if (isset($opts['gate'])) {
                    $gate = json_decode((string) $opts['gate'], true);

                    if (!is_array($gate)) {
                        fail('--gate is not JSON: ' . json_last_error_msg() . ". Quote it as one argument, as in --gate '{\"require\": {\"pow\": {\"bits\": 20}}}'");
                    }
                }

                out($runtime->openChannel((string) ($args[2] ?? fail('channel open LABEL')), (int) ($opts['ttl'] ?? 600), csv($opts['allow'] ?? null), $gate));
            } elseif ($action === 'list') {
                out($runtime->channelList());
            } elseif ($action === 'close') {
                out($runtime->closeChannel((string) ($args[2] ?? fail('channel close LABEL'))));
            } else {
                fail('channel open|list|close');
            }
            break;
        case 'board':
            $action = $args[1] ?? '';
            switch ($action) {
                case 'post':
                    out($runtime->boardPost((string) ($args[2] ?? fail('board post KIND TITLE TEXT')), (string) ($args[3] ?? fail('board post KIND TITLE TEXT')), (string) ($args[4] ?? fail('board post KIND TITLE TEXT')), csv($opts['tags'] ?? null) ?? [], (int) ($opts['ttl'] ?? Runtime::BOARD_TTL), $opts['lang'] ?? null, $opts['deadline'] ?? null, isset($opts['scope']) ? (string) $opts['scope'] : null));
                    break;
                case 'find':
                    out($runtime->boardFind($opts['kind'] ?? null, csv($opts['tags'] ?? null), $opts['lang'] ?? null, null, (int) ($opts['after'] ?? 0), (int) ($opts['wait'] ?? 0), (int) ($opts['min-work-bits'] ?? 0), isset($opts['scope']) ? (string) $opts['scope'] : null));
                    break;
                case 'tags':
                    out($runtime->boardTags());
                    break;
                case 'answer':
                    out($runtime->boardAnswer((string) ($args[2] ?? fail('board answer POST TEXT')), (string) ($args[3] ?? fail('board answer POST TEXT')), null, isset($opts['scope']) ? (string) $opts['scope'] : null));
                    break;
                case 'replies':
                    // Always, and the board inboxes only. With no wait given
                    // this read nothing at all, and said nobody had answered.
                    $runtime->boardPoll((int) ($opts['wait'] ?? 0));
                    $replies = $runtime->boardReplies($opts['post'] ?? null);
                    // How many messages this left out, every time and not only
                    // when it found nothing: an answer that names no post is
                    // still somebody answering.
                    $leftOut = $runtime->boardRepliesLeftOut;
                    $answer = ['replies' => $replies, 'left_out' => $leftOut, 'reply_address' => $runtime->boardReplyAddress(), 'attention' => $runtime->attentionTaken()];
                    if ($leftOut > 0) {
                        $answer['note'] = $leftOut . ' message(s) on your inboxes are not listed here, because they name no post of yours and did not arrive on a board inbox. aamio read shows every message.';
                    }
                    if (isset($opts['post'])) {
                        // What else is on the board inbox, so an empty list for
                        // one post is never read as an empty inbox.
                        $answer['others_on_the_board_inbox'] = count($runtime->boardReplies()) - count($replies);
                    }
                    out($answer);
                    break;
                case 'withdraw':
                    out($runtime->boardWithdraw((string) ($args[2] ?? fail('board withdraw POST'))));
                    break;
                case 'channel':
                    out($runtime->openChannelWith((string) ($args[2] ?? fail('board channel KEY')), (int) ($opts['ttl'] ?? 900), null, $opts['reply-to'] ?? null, $opts['note'] ?? null));
                    break;
                default:
                    fail('board post|find|tags|answer|replies|withdraw|channel');
            }
            break;
        case 'scope':
            $action = $args[1] ?? '';
            if ($action === 'new') {
                out($runtime->scopeNew((string) ($args[2] ?? fail('scope new NAME'))));
            } elseif ($action === 'add') {
                out($runtime->scopeAdd((string) ($args[2] ?? fail('scope add NAME --key KEY | --address ADDRESS')), isset($opts['key']) ? (string) $opts['key'] : null, isset($opts['address']) ? (string) $opts['address'] : null));
            } elseif ($action === 'list') {
                out(['scopes' => $runtime->scopeList()]);
            } elseif ($action === 'key') {
                out($runtime->scopeKey((string) ($args[2] ?? fail('scope key NAME'))));
            } elseif ($action === 'share') {
                out($runtime->scopeShare((string) ($args[2] ?? fail('scope share NAME PARTNER --access read|write')), (string) ($args[3] ?? fail('scope share NAME PARTNER --access read|write')), $opts['access'] ?? fail('scope share NAME PARTNER --access read|write')));
            } elseif ($action === 'remove') {
                out($runtime->scopeRemove((string) ($args[2] ?? fail('scope remove NAME'))));
            } else {
                fail('scope new|add|list|key|share|remove');
            }
            break;
        case 'outbox':
            $action = $args[1] ?? '';
            if ($action === 'pending') {
                out(['pending' => $runtime->outboxPending()]);
            } elseif ($action === 'retry') {
                out(['retried' => $runtime->outboxRetry($opts['id'] ?? null)]);
            } elseif ($action === 'forget') {
                out($runtime->outboxForget((string) ($args[2] ?? fail('outbox forget ID'))));
            } else {
                fail('outbox pending|retry|forget');
            }
            break;
        case 'serve':
            (new McpServer($runtime))->serve();
            break;
        default:
            fail('unknown command: ' . $command . '. Run aamio help.');
    }
} catch (SendFailed $error) {
    [$retryable, $fix] = Runtime::sendAdvice($error->outcome, $error->status);
    out(['error' => $error->getMessage(), 'outcome' => $error->outcome, 'message_id' => $error->messageId, 'status' => $error->status, 'retryable' => $retryable, 'fix' => $fix]);
    exit(2);
} catch (GateStop $error) {
    out(['error' => $error->getMessage(), 'fix' => $error->fix]);
    exit(2);
} catch (\Throwable $error) {
    fail($error->getMessage());
}
