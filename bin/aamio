#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * aamio on the command line, from PHP. The same commands as aamio-python's
 * CLI, over the same home directory layout.
 *
 *   aamio [--home DIR] [--host URL] [--tags a,b] [--no-archive] <command> ...
 *   aamio --version              (aamio and the version of this client)
 *   (--host moves the service and nothing else: the board is AAMIO_BOARD, else
 *   https://board.aamio.at, and a receipt is anchored at AAMIO_VERIFYUM, else
 *   Verifyum's MCP server. For a copy of both on this machine, name both)
 *
 *   init | whoami | partner add NAME KEY | partner list | partner remove NAME
 *   lookup [NAME ...] [--wait N] | send TO TEXT [--data JSON] [--re SHA256]
 *   trace [WHO] [--limit N]   (what was sent to one counterpart and what came back, as hashes)
 *   read [--wait N] [--limit N] [--max-bytes N]
 *   (--max-bytes is per channel, and a message larger than it stays at the service, named in attention)
 *   receipt [--channel LABEL] [--anchor] | channel open LABEL [--ttl N] [--allow a,b]
 *   archive [status|keep|off|days:N|prune] [--max-mb M] [--all] | doctor
 *   channel list | channel close LABEL | board post KIND TITLE TEXT [--tags a,b] [--ttl N] [--lang L] [--deadline ISO] [--scope NAME]
 *   board find [--kind K] [--tags a,b] [--lang L] [--after N] [--wait N] [--min-work-bits N] [--scope NAME]
 *   board tags | board answer POST TEXT [--data JSON] [--scope NAME] | board replies [--post ID] [--wait N] | board withdraw POST
 *   (board replies filters. read shows everything on the inbox, opened bodies and the ones that would not open)
 *   board channel KEY [--ttl N] [--reply-to W] [--note TEXT]
 *   scope new NAME | scope add NAME (--key KEY | --address ADDRESS) | scope list | scope key NAME
 *   scope share NAME PARTNER --access read|write | scope remove NAME
 *   (a key given to scope add stays in the shell history, so scope share from runtime to runtime is better)
 *   outbox pending | outbox retry [--id ID] | outbox forget ID | serve
 *   addon list                   (the add-ons installed beside aamio, and which of them run here)
 *   addon enable NAME            (let an installed add-on run here; disable takes it out again)
 *   addon NAME ...               (an add-on's commands: aamio addon domain --help with Domain Keys)
 */

// Diagnostics to stderr from here on, so stdout carries the JSON and nothing
// else. On PHP 8.5 a deprecation raised by the transport was printed on stdout
// ahead of the answer, and `aamio doctor` exited 0 with output no parser would
// take (C1 of the follow-up review of 25 September 2026). What PHP says while
// it starts, before this line, is beyond reach from here: for that, run it
// with -d display_errors=stderr.
ini_set('display_errors', 'stderr');

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php', __DIR__ . '/../tests/bootstrap.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

use Aamio\Addons;
use Aamio\Codec;
use Aamio\CodedInvalidArgument;
use Aamio\Compat;
use Aamio\GateStop;
use Aamio\Http;
use Aamio\McpServer;
use Aamio\Runtime;
use Aamio\SendFailed;
use Aamio\Storage;

function out(mixed $value): void
{
    fwrite(STDOUT, json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
}

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, $message . "\n");
    exit($code);
}

/** Splits argv into positionals and --options; an option followed by a value takes it, a bare flag is true. */
function parse(array $argv, array $flags = []): array
{
    $positional = [];
    $options = [];
    for ($i = 0; $i < count($argv); $i++) {
        $arg = $argv[$i];
        if (str_starts_with($arg, '--')) {
            $name = substr($arg, 2);
            if (str_contains($name, '=')) {
                [$name, $value] = explode('=', $name, 2);
                $options[$name] = $value;
            } elseif (in_array($name, $flags, true) || !isset($argv[$i + 1]) || str_starts_with($argv[$i + 1], '--')) {
                $options[$name] = true;
            } else {
                $options[$name] = $argv[++$i];
            }
        } else {
            $positional[] = $arg;
        }
    }

    return [$positional, $options];
}

function csv(?string $text): ?array
{
    if ($text === null || $text === '') {
        return null;
    }

    return array_values(array_filter(array_map('trim', explode(',', $text)), static fn (string $t): bool => $t !== ''));
}

[$args, $opts] = parse(array_slice($argv, 1), ['no-archive', 'anchor', 'all', 'help', 'version']);
// An option that takes a value, given without one, is refused before anything
// is read or written: `--home` alone would otherwise mean the default home.
foreach (['home' => 'DIR', 'host' => 'URL', 'tags' => 'a,b'] as $takesValue => $what) {
    if (array_key_exists($takesValue, $opts) && (!is_string($opts[$takesValue]) || $opts[$takesValue] === '')) {
        fail('--' . $takesValue . ' needs a value: aamio --' . $takesValue . ' ' . $what . ' <command> ...', 2);
    }
}
$command = $args[0] ?? null;
// As aamio-python and the Node runtime print it. It printed the help instead
// (a check of 13 November 2026).
if ($command === null && ($opts['version'] ?? null) === true) {
    fwrite(STDOUT, 'aamio ' . Http::VERSION . "\n");
    exit(0);
}
if ($command === null || in_array($command, ['help', '-h'], true)) {
    fail(trim(preg_replace('/^ \* ?/m', '', (string) preg_replace('!^.*?/\*\*(.*?)\*/.*$!s', '$1', (string) file_get_contents(__FILE__)))), 0);
}

// The add-ons: which of them run here is kept in the home the command line was
// given. `addon disable` comes before they are loaded, so that a broken one can
// be taken out again, and `addon enable` lets one in only once it loads clean.
Addons::useHome(isset($opts['home']) && is_string($opts['home']) ? $opts['home'] : null);
$addonChange = static function (string $verb, array $args, array $opts): never {
    // The whole command line is judged before anything is written: help is
    // help, and a word or an option that does not belong refuses the change.
    $usage = 'aamio addon ' . $verb . ' NAME: an add-on\'s short name, or its package';
    if (isset($opts['help'])) {
        fwrite(STDOUT, $usage . "\n");
        exit(0);
    }
    $unknown = array_diff(array_keys($opts), ['home', 'host', 'tags', 'no-archive', 'anchor']);
    if ($unknown !== []) {
        fail('unknown option --' . implode(', --', $unknown) . '. ' . $usage, 2);
    }
    if (count($args) !== 3 || !is_string($args[2]) || $args[2] === '' || str_starts_with($args[2], '-')) {
        fail($usage, 2);
    }
    try {
        out($verb === 'enable' ? Addons::enable($args[2]) : Addons::disable($args[2]));
    } catch (\RuntimeException $error) {
        fail($error->getMessage(), 2);
    }
    exit(0);
};
if ($command === 'addon' && ($args[1] ?? null) === 'disable') {
    $addonChange('disable', $args, $opts);
}
// What runs beyond the core. An add-on that cannot be used stops here with the
// reason, whatever the command: a broken install is not a quiet absence. The
// list still answers, from the metadata, and says what is broken and how to
// take it out.
try {
    Addons::loaded();
} catch (\RuntimeException $error) {
    if ($command === 'addon' && ($args[1] ?? null) === 'list') {
        try {
            out(Addons::describe());
            exit(1);
        } catch (\RuntimeException $again) {
            fail($again->getMessage());
        }
    }
    fail($error->getMessage());
}
// Before the runtime: creating one takes the home's lock and tidies the home.
// Listing the add-ons reads nothing, and an add-on may have commands of its own
// that need no home, as a check of a local file beside a running server.
if ($command === 'addon') {
    $which = $args[1] ?? fail('aamio addon list, enable NAME, disable NAME, or aamio addon NAME ... for an enabled add-on', 2);
    if ($which === 'list') {
        out(Addons::describe());
        exit(0);
    }
    if ($which === 'enable') {
        $addonChange('enable', $args, $opts);
    }
    $addon = Addons::byName($which);
    if ($addon === null) {
        foreach (Addons::installed() as $row) {
            if ($row['name'] === $which) {
                fail('the add-on ' . $which . ' is installed and not enabled. aamio addon enable ' . $which . ' lets it run here.', 2);
            }
        }
        fail('no add-on is called ' . $which . '. aamio addon list says which are installed.', 2);
    }
    $code = $addon->early(array_slice($args, 2), $opts);
    if ($code !== null) {
        exit($code);
    }
}

// What can be seen to be wrong from the command line alone is refused here,
// before the home is opened or made, as aamio-python and the Node runtime
// refuse it: on stderr, with 2. It was refused after the home was made, with
// 1, an option the command does not take was passed over, and a number that
// was no number was taken as 0 (a check of 13 November 2026). A partner's
// name or key and send --re are the command's answer instead, as JSON with 1,
// as in the other two, and no home is made for them either.
// --data as it was checked before the home, which is what is sent: decoded
// once, objects as objects (the release check of 14 November 2026).
$checkedData = null;
if ($command !== 'addon') {
    $commands = [
        // The words it takes, how many of the last may be left out, its options, its switches.
        'init' => [[], 0, ['archive'], []],
        'whoami' => [[], 0, [], []],
        'doctor' => [[], 0, [], []],
        'serve' => [[], 0, [], []],
        'partner add' => [['name', 'key'], 0, [], []],
        'partner list' => [[], 0, [], []],
        'partner remove' => [['name'], 0, [], []],
        'lookup' => [null, 0, ['wait'], []],
        'send' => [['to', 'text'], 0, ['data', 're'], []],
        'read' => [[], 0, ['wait', 'limit', 'max-bytes'], []],
        'receipt' => [[], 0, ['channel'], ['anchor']],
        'outbox pending' => [[], 0, [], []],
        'outbox retry' => [[], 0, ['id'], []],
        'outbox forget' => [['id'], 0, [], []],
        'trace' => [['who'], 1, ['limit'], []],
        'board post' => [['kind', 'title', 'text'], 0, ['ttl', 'lang', 'deadline', 'scope'], []],
        'board find' => [[], 0, ['kind', 'lang', 'after', 'wait', 'min-work-bits', 'scope'], []],
        'board tags' => [[], 0, [], []],
        'board answer' => [['post', 'text'], 0, ['data', 'scope'], []],
        'board withdraw' => [['post'], 0, [], []],
        'board replies' => [[], 0, ['post', 'wait'], []],
        'board channel' => [['key'], 0, ['ttl', 'reply-to', 'note'], []],
        'scope new' => [['name'], 0, [], []],
        'scope add' => [['name'], 0, ['key', 'address'], []],
        'scope list' => [[], 0, [], []],
        'scope key' => [['name'], 0, [], []],
        'scope share' => [['name', 'partner'], 0, ['access'], []],
        'scope remove' => [['name'], 0, [], []],
        'channel open' => [['label'], 0, ['ttl', 'allow', 'gate'], []],
        'channel list' => [[], 0, [], []],
        'channel close' => [['label'], 0, [], []],
        'archive' => [['policy'], 1, ['max-mb'], ['all']],
    ];
    $used = in_array($command, ['partner', 'outbox', 'board', 'scope', 'channel'], true) ? trim($command . ' ' . (string) ($args[1] ?? '')) : (string) $command;
    if (!isset($commands[$used])) {
        fail('Expected one of: ' . implode(', ', array_keys($commands)) . '. Run aamio help for usage.', 2);
    }
    [$words, $optional, $takes, $switches] = $commands[$used];
    $given = array_slice($args, count(explode(' ', $used)));
    if ($words !== null && (count($given) < count($words) - $optional || count($given) > count($words))) {
        $named = array_map(static fn (string $word, int $at): string => $at < count($words) - $optional ? strtoupper($word) : '[' . strtoupper($word) . ']', $words, array_keys($words));
        fail($used . ' takes ' . ($words === [] ? 'no arguments' : implode(' ', $named)) . '. Run aamio help for usage.', 2);
    }
    // --tags is the runtime's own on every command here, as it always was, and
    // the tags of a post or a filter on board post and board find.
    foreach ($opts as $name => $value) {
        if (in_array($name, ['home', 'host', 'tags', 'no-archive', 'help', 'version'], true)) {
            continue;
        }
        if (in_array($name, $switches, true)) {
            if ($value !== true) {
                fail('--' . $name . ' takes no value.', 2);
            }
            continue;
        }
        if (!in_array($name, $takes, true)) {
            fail($used . ' does not take --' . $name . '. Run aamio help for usage.', 2);
        }
        if (!is_string($value)) {
            fail('--' . $name . ' needs a value.', 2);
        }
    }
    $whole = static function (string $name, int $low, ?int $high = null) use ($opts): void {
        if (!isset($opts[$name])) {
            return;
        }
        $value = (string) $opts[$name];
        if (preg_match('/^[0-9]{1,15}$/D', $value) !== 1 || (int) $value < $low || ($high !== null && (int) $value > $high)) {
            fail($high === null ? '--' . $name . ' is a whole number, ' . $low . ' or more.' : '--' . $name . ' is a whole number from ' . $low . ' to ' . $high . '.', 2);
        }
    };
    // A check of the runtime's, said as a usage error, as the Node runtime says it.
    $asUsage = static function (callable $check): void {
        try {
            $check();
        } catch (\InvalidArgumentException $wrong) {
            $text = $wrong->getMessage();
            fail(ucfirst($text) . (str_ends_with($text, '.') ? '' : '.'), 2);
        }
    };
    $json = static function (string $name, string $wrong) use ($opts): mixed {
        if (!isset($opts[$name])) {
            return null;
        }
        try {
            // --data in the form it is sent in, objects as objects, so what is
            // checked here before the home is what goes out: as arrays, a
            // member name that starts with U+0000 passed here and stopped the
            // command after the home was opened (the release check of 14
            // November 2026).
            $value = json_decode((string) $opts[$name], $name !== 'data', 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException $error) {
            if ($error->getCode() === JSON_ERROR_INVALID_PROPERTY_NAME) {
                fail('--' . $name . ' has a member name that starts with U+0000, which this PHP cannot hold in an object. Name it otherwise.', 2);
            }
            if ($error->getCode() !== JSON_ERROR_DEPTH) {
                fail($wrong, 2);
            }
            $value = [[]];
        }
        // A number that is not finite, as 1e999 is, which decodes to INF here,
        // and --data nested so deep that the message around it passes
        // Codec::BODY_MAX_DEPTH, which a reader hands over as text. The three
        // runtimes refuse both alike (a security review of 13 November 2026).
        $unreadable = Codec::unfitJson($value, $name === 'data' ? Codec::BODY_MAX_DEPTH - 1 : PHP_INT_MAX);
        if (isset($error) && $error->getCode() === JSON_ERROR_DEPTH) {
            $unreadable = ['', 'too deep'];
        }
        if ($unreadable !== null && $unreadable[1] === 'not finite') {
            fail('--' . $name . ' holds a number that is not finite, as 1e999 is: JSON can write it, and nothing that reads it can hold it.', 2);
        }
        if ($unreadable !== null) {
            fail('--' . $name . ' is nested too deep: with the message around it, it is deeper than ' . Codec::BODY_MAX_DEPTH . ', and a reader hands such a message over as text.', 2);
        }

        return $value;
    };
    $noData = '--data is not JSON. Give a JSON value, quoted for the shell.';
    $scopeName = static function (string $option) use ($opts, $asUsage): void {
        if (isset($opts[$option])) {
            $asUsage(static fn () => Runtime::checkScopeName($opts[$option]));
        }
    };
    // The command's answer, as JSON with 1, before anything is opened or made.
    $answer = static function (callable $check): void {
        try {
            $check();
        } catch (CodedInvalidArgument $wrong) {
            out(['error' => $wrong->getMessage(), 'error_code' => $wrong->errorCode()]);
            exit(1);
        }
    };
    switch ($used) {
        case 'init':
            if (isset($opts['archive'])) {
                $asUsage(static fn () => Storage::parsePolicy((string) $opts['archive'], null));
            }
            break;
        case 'archive':
            $policy = (string) ($given[0] ?? 'status');
            $size = $opts['max-mb'] ?? null;
            if ($size !== null && (preg_match('/^[0-9]{1,9}(?:\.[0-9]{1,6})?$/D', (string) $size) !== 1 || !((float) $size > 0))) {
                fail('--max-mb is a size in megabytes above zero.', 2);
            }
            if ($policy === 'status' || $policy === 'prune') {
                if ($size !== null) {
                    fail('--max-mb goes with a choice: archive keep, archive off or archive days:N.', 2);
                }
                if (isset($opts['all']) && $policy !== 'prune') {
                    fail('--all goes with archive prune, and removes the whole archive.', 2);
                }
            } else {
                if (isset($opts['all'])) {
                    fail('--all goes with archive prune, and removes the whole archive.', 2);
                }
                $asUsage(static fn () => Storage::parsePolicy($policy, $size === null ? null : (float) $size));
            }
            break;
        case 'partner add':
            $answer(static fn () => Runtime::checkPartner($given[0], $given[1]));
            break;
        case 'lookup':
            $whole('wait', 0, 25);
            break;
        case 'send':
            $answer(static fn () => Runtime::checkRe($opts['re'] ?? null));
            $checkedData = $json('data', $noData);
            break;
        case 'trace':
            $whole('limit', 1, 50);
            break;
        case 'read':
            $whole('wait', 0, 25);
            $whole('limit', 1, 200);
            $whole('max-bytes', 512);
            break;
        case 'receipt':
            if (($opts['channel'] ?? null) === '') {
                fail("--channel names a channel, as a message's channel field does: inbox, board or an older generation.", 2);
            }
            break;
        case 'outbox retry':
            if (($opts['id'] ?? null) === '') {
                fail('--id names one message, as outbox pending shows it.', 2);
            }
            break;
        case 'outbox forget':
            if ($given[0] === '') {
                fail('outbox forget takes the id of one message, as outbox pending shows it.', 2);
            }
            break;
        case 'board post':
            if (!in_array($given[0], ['need', 'offer'], true)) {
                fail('A post is a need or an offer.', 2);
            }
            $whole('ttl', 60, 3600);
            $scopeName('scope');
            break;
        case 'board find':
            if (isset($opts['kind']) && !in_array($opts['kind'], ['need', 'offer'], true)) {
                fail('A post is a need or an offer.', 2);
            }
            $whole('after', 0, 999999);
            $whole('wait', 0, 25);
            $whole('min-work-bits', 0, 16);
            $scopeName('scope');
            break;
        case 'board answer':
            $checkedData = $json('data', $noData);
            $scopeName('scope');
            break;
        case 'board replies':
            $whole('wait', 0, 25);
            if (($opts['post'] ?? null) === '') {
                fail('--post names one post by its id, as board post answered it.', 2);
            }
            break;
        case 'board channel':
            $whole('ttl', 30, 3600);
            if (isset($opts['reply-to']) && preg_match('/^[a-z2-7]{20}$/D', (string) $opts['reply-to']) !== 1) {
                fail('--reply-to is a write address: 20 characters of a-z and 2-7, as a verified answer gives it in reply_to.', 2);
            }
            if (isset($opts['note']) && !isset($opts['reply-to'])) {
                fail('--note travels with the address to the inbox --reply-to names, so without --reply-to there is nothing to carry it.', 2);
            }
            if ($given[0] === '') {
                fail("board channel takes a key, or a partner's name.", 2);
            }
            break;
        case 'channel open':
            $asUsage(static fn () => Runtime::checkLabel($given[0]));
            $whole('ttl', 30, 3600);
            $asUsage(static fn () => Runtime::checkChannelTtl((int) ($opts['ttl'] ?? 600)));
            if (isset($opts['gate'])) {
                $gate = $json('gate', "--gate is not JSON. Quote it as one argument, as in --gate '{\"require\": {\"pow\": {\"bits\": 20}}}'.");
                $asUsage(static fn () => Runtime::checkGate($gate));
            }
            break;
        case 'channel close':
            if ($given[0] === '') {
                fail('channel close takes the label of one channel, as channel list shows it.', 2);
            }
            break;
        case 'scope new':
        case 'scope key':
        case 'scope remove':
            $asUsage(static fn () => Runtime::checkScopeName($given[0]));
            break;
        case 'scope share':
            $asUsage(static fn () => Runtime::checkScopeName($given[0]));
            if (!isset($opts['access'])) {
                fail('scope share takes --access read, which gives the key to read and post, or --access write, which gives the address to post only.', 2);
            }
            $asUsage(static fn () => Runtime::checkAccess($opts['access']));
            break;
        case 'scope add':
            $asUsage(static fn () => Runtime::checkScopeAdd($given[0], $opts['key'] ?? null, $opts['address'] ?? null));
            break;
    }
}

try {
    // --tags on `board post` is the tags of that post, and on `board find` a
    // filter. Every --tags used to become this runtime's own: whoami showed the
    // last post's tags, and presence published them as where this key can be
    // reached. --no-archive is one command; the folder's own choice is the
    // default and lives in config.json.
    $runtimeTags = $command === 'board' ? null : csv($opts['tags'] ?? null);
    $runtime = new Runtime($opts['home'] ?? null, $opts['host'] ?? null, $runtimeTags, isset($opts['no-archive']) ? false : null, static fn (string $line) => fwrite(STDERR, $line . "\n"));
} catch (\Throwable $error) {
    fail($error->getMessage());
}
// The lock goes with the process however it ends. fail() exits, and an exit
// inside try never reaches finally, so a command that failed on its arguments
// used to leave the home locked.
register_shutdown_function([$runtime, 'close']);

try {
    switch ($command) {
        case 'init':
            if (isset($opts['archive'])) {
                $runtime->setArchive(Storage::parsePolicy((string) $opts['archive'], isset($opts['max-mb']) ? (float) $opts['max-mb'] : null));
            }
            $runtime->ensureInbox();
            $runtime->saveState();
            // Said once, where a person sets the runtime up: the service
            // forgets, and this folder does not unless it is told to.
            out($runtime->whoami() + ['local_storage' => Storage::status($runtime->home, $runtime->archivePolicy) + ['home' => $runtime->home, 'who_can_read' => Storage::check($runtime->home)]]);
            break;
        case 'archive':
            $policy = (string) ($args[1] ?? 'status');
            if ($policy === 'prune') {
                $gone = Storage::prune($runtime->home, $runtime->archivePolicy, null, isset($opts['all']));
                out(Storage::status($runtime->home, $runtime->archivePolicy) + ['removed' => $gone['removed']]);
            } elseif ($policy === 'status') {
                out(Storage::status($runtime->home, $runtime->archivePolicy));
            } else {
                $runtime->setArchive(Storage::parsePolicy($policy, isset($opts['max-mb']) ? (float) $opts['max-mb'] : null));
                out(Storage::status($runtime->home, $runtime->archivePolicy));
            }
            break;
        case 'doctor':
            // One answer to three questions: does this client fit the service,
            // who can read the home, what is kept. Nothing here is a guess
            // reported as a finding: what could not be checked says so.
            $health = $runtime->client->health();
            // Whether the service answered and whether it is well are two
            // things, and both apart from whether this client fits it. A 503
            // from /health was said as no answer, beside a fit read from the
            // descriptor, which had answered (a check of 13 November 2026). As
            // aamio-python and the Node runtime say it.
            // Healthy is aamio's own health answer, an object with "service":
            // "aamio" and "status": "ok" as the service gives it. A 200 from a
            // proxy or a login page in front of the host was said as healthy,
            // beside "answered 200 and not 200" (a check of 13 November 2026).
            $body = $health['body'];
            $unlike = match (true) {
                $health['status'] !== 200 => null,
                $body === null || $body === '' => 'an empty body',
                is_string($body) => 'a body that is not JSON',
                !is_array($body) || ($body['service'] ?? null) !== 'aamio' || ($body['status'] ?? null) !== 'ok' => "JSON that is not aamio's health answer",
                default => null,
            };
            $service = ['host' => $runtime->host, 'reachable' => $health['status'] > 0, 'healthy' => $health['status'] === 200 && $unlike === null, 'status' => $health['status']];
            if ($service['healthy']) {
                $service['version'] = $body['version'] ?? null;
                $service['revision'] = $body['revision'] ?? null;
            } elseif ($health['status'] === 0) {
                $service['problem'] = "no answer from /health, so the service's version and health were not read";
            } elseif ($health['status'] !== 200) {
                $service['problem'] = '/health answered ' . $health['status'] . ' and not 200: the service is reachable and not healthy, and its version was not read';
            } else {
                $service['problem'] = '/health answered 200 with ' . $unlike . ", so the service's version and health were not read: check that --host names the aamio service and not a page in front of it";
            }
            $descriptor = $runtime->client->descriptor();
            $fits = Compat::check($descriptor['status'] === 200 && is_array($descriptor['body']) ? $descriptor['body'] : null);
            if ($descriptor['status'] !== 200) {
                $fits['verdict'] = 'unknown';
                $fits['why'] = 'the descriptor could not be read (' . $descriptor['status'] . '), so compatibility was not checked';
            }
            out([
                'client' => ['name' => 'aamio-php', 'version' => Http::VERSION, 'protocol' => Compat::PROTOCOL],
                'service' => $service,
                'compatibility' => $fits,
                'storage' => Storage::check($runtime->home),
                'archive' => Storage::status($runtime->home, $runtime->archivePolicy),
                'outbox_pending' => count($runtime->outboxPending()),
            ]);
            break;
        case 'whoami':
            out($runtime->whoami());
            break;
        case 'partner':
            $action = $args[1] ?? '';
            // What the change did to the inbox is in the answer: the address a
            // partner can write to now, or that the old one stays because the
            // new one could not be opened.
            if ($action === 'add') {
                $changed = $runtime->partnerAdd((string) ($args[2] ?? fail('partner add NAME KEY')), (string) ($args[3] ?? fail('partner add NAME KEY')));
                out($changed + ['partners' => $runtime->partnerList()]);
            } elseif ($action === 'list') {
                // An object, as aamio-python and the Node runtime answer and
                // as the local server does. It was a bare list here.
                out(['partners' => $runtime->partnerList()]);
            } elseif ($action === 'remove') {
                $changed = $runtime->partnerRemove((string) ($args[2] ?? fail('partner remove NAME')));
                out($changed + ['partners' => $runtime->partnerList()]);
            } else {
                fail('partner add|list|remove');
            }
            break;
        case 'lookup':
            out($runtime->lookup(array_slice($args, 1) ?: null, (int) ($opts['wait'] ?? 0)));
            break;
        case 'send':
            // As it was given, objects as objects: as arrays, {"0": "a"} went
            // out as ["a"], and a value that was not an array not at all.
            $data = isset($opts['data']) ? Codec::jsonValue($checkedData) : null;
            out($runtime->send((string) ($args[1] ?? fail('send TO TEXT')), (string) ($args[2] ?? fail('send TO TEXT')), $data, null, isset($opts['re']) ? (string) $opts['re'] : null));
            break;
        case 'trace':
            try {
                out($runtime->trace(isset($args[1]) ? (string) $args[1] : null, isset($opts['limit']) ? (int) $opts['limit'] : 20));
            } catch (\RuntimeException $error) {
                fail($error->getMessage());
            }
            break;
        case 'read':
            // attention carries what the read could not do. Without it an
            // expired thread and a service that did not answer both read as
            // no messages at all.
            //
            // --limit and --max-bytes were written into the README of 0.2.14 and
            // into no line of this file, so the command took them, ignored them
            // and answered with whatever the thread held. A documented option
            // that does nothing is worse than an undocumented one.
            $askedLimit = isset($opts['limit']) ? (int) $opts['limit'] : 50;
            $askedBytes = isset($opts['max-bytes']) ? (int) $opts['max-bytes'] : null;

            if ($askedLimit < 1 || $askedLimit > 200) {
                fail('--limit is a whole number of messages from 1 to 200');
            }

            if ($askedBytes !== null && $askedBytes < 512) {
                fail('--max-bytes is 512 or more. One message can be 65536 bytes, and a budget under that is answered with the message named in too_large rather than cut.');
            }

            $messages = $runtime->read((int) ($opts['wait'] ?? 0), $askedLimit, $askedBytes);
            out(['messages' => $messages, 'count' => count($messages), 'attention' => $runtime->attentionTaken()]);
            break;
        case 'receipt':
            out($runtime->receipt((string) ($opts['channel'] ?? 'inbox'), isset($opts['anchor'])));
            break;
        case 'channel':
            $action = $args[1] ?? '';
            if ($action === 'open') {
                // A shell eats quotes, so a gate that will not parse is named by the
                // option the person typed, not by a decoder they cannot see.
                $gate = null;

                if (isset($opts['gate'])) {
                    $gate = json_decode((string) $opts['gate'], true);

                    if (!is_array($gate)) {
                        fail('--gate is not JSON: ' . json_last_error_msg() . ". Quote it as one argument, as in --gate '{\"require\": {\"pow\": {\"bits\": 20}}}'");
                    }
                }

                out($runtime->openChannel((string) ($args[2] ?? fail('channel open LABEL')), (int) ($opts['ttl'] ?? 600), csv($opts['allow'] ?? null), $gate));
            } elseif ($action === 'list') {
                // An object, as the other two runtimes answer and as the local server does.
                out(['channels' => $runtime->channelList()]);
            } elseif ($action === 'close') {
                out($runtime->closeChannel((string) ($args[2] ?? fail('channel close LABEL'))));
            } else {
                fail('channel open|list|close');
            }
            break;
        case 'board':
            $action = $args[1] ?? '';
            switch ($action) {
                case 'post':
                    out($runtime->boardPost((string) ($args[2] ?? fail('board post KIND TITLE TEXT')), (string) ($args[3] ?? fail('board post KIND TITLE TEXT')), (string) ($args[4] ?? fail('board post KIND TITLE TEXT')), csv($opts['tags'] ?? null) ?? [], (int) ($opts['ttl'] ?? Runtime::BOARD_TTL), $opts['lang'] ?? null, $opts['deadline'] ?? null, isset($opts['scope']) ? (string) $opts['scope'] : null));
                    break;
                case 'find':
                    out($runtime->boardFind($opts['kind'] ?? null, csv($opts['tags'] ?? null), $opts['lang'] ?? null, null, (int) ($opts['after'] ?? 0), (int) ($opts['wait'] ?? 0), (int) ($opts['min-work-bits'] ?? 0), isset($opts['scope']) ? (string) $opts['scope'] : null));
                    break;
                case 'tags':
                    out($runtime->boardTags());
                    break;
                case 'answer':
                    $answerData = isset($opts['data']) ? Codec::jsonValue($checkedData) : null;
                    out($runtime->boardAnswer((string) ($args[2] ?? fail('board answer POST TEXT')), (string) ($args[3] ?? fail('board answer POST TEXT')), $answerData, isset($opts['scope']) ? (string) $opts['scope'] : null));
                    break;
                case 'replies':
                    // Always, and the board inboxes only. With no wait given
                    // this read nothing at all, and said nobody had answered.
                    $runtime->boardPoll((int) ($opts['wait'] ?? 0));
                    $replies = $runtime->boardReplies($opts['post'] ?? null);
                    // How many messages this left out, every time and not only
                    // when it found nothing: an answer that names no post is
                    // still somebody answering.
                    $leftOut = $runtime->boardRepliesLeftOut;
                    $answer = ['replies' => $replies, 'left_out' => $leftOut, 'reply_address' => $runtime->boardReplyAddress(), 'attention' => $runtime->attentionTaken()];
                    if ($leftOut > 0) {
                        $answer['note'] = $leftOut . ' message(s) on your inboxes are not listed here, because they name no post of yours and did not arrive on a board inbox. aamio read shows every message.';
                    }
                    if (isset($opts['post'])) {
                        // What else is on the board inbox, so an empty list for
                        // one post is never read as an empty inbox.
                        $answer['others_on_the_board_inbox'] = count($runtime->boardReplies()) - count($replies);
                    }
                    out($answer);
                    break;
                case 'withdraw':
                    out($runtime->boardWithdraw((string) ($args[2] ?? fail('board withdraw POST'))));
                    break;
                case 'channel':
                    out($runtime->openChannelWith((string) ($args[2] ?? fail('board channel KEY')), (int) ($opts['ttl'] ?? 900), null, $opts['reply-to'] ?? null, $opts['note'] ?? null));
                    break;
                default:
                    fail('board post|find|tags|answer|replies|withdraw|channel');
            }
            break;
        case 'scope':
            $action = $args[1] ?? '';
            if ($action === 'new') {
                out($runtime->scopeNew((string) ($args[2] ?? fail('scope new NAME'))));
            } elseif ($action === 'add') {
                out($runtime->scopeAdd((string) ($args[2] ?? fail('scope add NAME --key KEY | --address ADDRESS')), isset($opts['key']) ? (string) $opts['key'] : null, isset($opts['address']) ? (string) $opts['address'] : null));
            } elseif ($action === 'list') {
                out(['scopes' => $runtime->scopeList()]);
            } elseif ($action === 'key') {
                out($runtime->scopeKey((string) ($args[2] ?? fail('scope key NAME'))));
            } elseif ($action === 'share') {
                out($runtime->scopeShare((string) ($args[2] ?? fail('scope share NAME PARTNER --access read|write')), (string) ($args[3] ?? fail('scope share NAME PARTNER --access read|write')), $opts['access'] ?? fail('scope share NAME PARTNER --access read|write')));
            } elseif ($action === 'remove') {
                out($runtime->scopeRemove((string) ($args[2] ?? fail('scope remove NAME'))));
            } else {
                fail('scope new|add|list|key|share|remove');
            }
            break;
        case 'outbox':
            $action = $args[1] ?? '';
            if ($action === 'pending') {
                out(['pending' => $runtime->outboxPending()]);
            } elseif ($action === 'retry') {
                out(['retried' => $runtime->outboxRetry($opts['id'] ?? null)]);
            } elseif ($action === 'forget') {
                out($runtime->outboxForget((string) ($args[2] ?? fail('outbox forget ID'))));
            } else {
                fail('outbox pending|retry|forget');
            }
            break;
        case 'addon':
            exit(Addons::byName((string) $args[1])->command(array_slice($args, 2), $opts, $runtime));
        case 'serve':
            (new McpServer($runtime))->serve();
            break;
        default:
            fail('unknown command: ' . $command . '. Run aamio help.');
    }
} catch (SendFailed | GateStop $error) {
    // With the channel that is open, when the message that was stopped
    // carried a channel's address: board channel opens one first. Exit 1, as
    // in aamio-python and the Node runtime: 2 is a command given wrong.
    out(Runtime::commandLineStop($error));
    exit(1);
} catch (\Exception $error) {
    // What a command could not do is its answer: JSON on standard output with
    // error and error_code, as aamio-python and the Node runtime answer it. It
    // was a line on standard error (a check of 13 November 2026). A fault in
    // this client itself is still said there. So is a server that cannot
    // start: standard output is the protocol's alone, and a line there that is
    // no protocol message is one the host cannot read.
    if ($command === 'serve') {
        fail($error->getMessage());
    }
    out(['error' => $error->getMessage(), 'error_code' => Runtime::errorCode($error)]);
    exit(1);
} catch (\Throwable $error) {
    fail($error->getMessage());
}
